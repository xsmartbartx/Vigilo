# Production environment for the single-VPS deployment (docker-compose.self-host.yml
# + Caddy). Copy to `.env` ON THE SERVER and fill in. Never commit the real file,
# never reuse your local development values, and keep LIVE keys out of every other
# machine. Variables marked REQUIRED have no safe default.
#
# Generate secrets with:  openssl rand -base64 32 | tr -d '/+=' | cut -c1-32

ENV=production

# --- Public hostnames (REQUIRED) -------------------------------------------------
# Two DNS A records pointing at the VPS first. Caddy gets the TLS certificates.
WEB_DOMAIN=
API_DOMAIN=
# https:// + the domains above. The API's CORS check is an exact string match, so
# WEB_APP_URL must be exactly https://<WEB_DOMAIN> with no trailing slash.
WEB_APP_URL=
PUBLIC_API_BASE_URL=
# Optional extras (leave empty if unused)
ADDITIONAL_CORS_ORIGINS=
EXTRA_WEB_DOMAIN=

# --- Data stores (REQUIRED: the compose file falls back to a published dev
# password if these are unset, so set both) ----------------------------------
POSTGRES_PASSWORD=
OBJECT_STORE_SECRET_KEY=
# Used by the compose stack's MinIO. Leave as is unless you change the compose file.
OBJECT_STORE_BUCKET=vigilo-evidence

# --- Clerk, PRODUCTION instance (REQUIRED) ------------------------------------
# Create a separate production instance in Clerk, add WEB_DOMAIN to its allowed
# origins, create the JWT template `vigilo-api` with an `email` claim, and use the
# pk_live_ / sk_live_ keys here. The JWKS URL is
# https://<clerk frontend api host>/.well-known/jwks.json
CLERK_SECRET_KEY=
CLERK_JWKS_URL=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_JWT_TEMPLATE=vigilo-api

# --- Stripe, LIVE mode ---------------------------------------------------------
# The product, prices and portal configuration are created by
#   uv run python scripts/stripe_setup.py --mode live --apply
# run from your own shell. STRIPE_WEBHOOK_SECRET is printed once when the webhook
# endpoint is created (add --webhook-url https://<API_DOMAIN>/v1/billing/webhook).
# The key must be a full secret key (sk_live_), not a restricted rk_ key.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_PRO_YEARLY=
STRIPE_PORTAL_CONFIGURATION_ID=

# --- NEXORA Core billing sync --------------------------------------------------
# MUST match Core's NEXORA_SYNC_SECRET, or Core's signed plan updates are rejected (401).
# Production has had this set since the Core integration; keep the existing value.
NEXORA_SYNC_SECRET=
NEXORA_CONSOLE_BILLING_URL=

# --- Email (REQUIRED for invites and scan reports) ------------------------------
# Postmark server token, with the sending domain verified (SPF + DKIM, then DMARC).
POSTMARK_SERVER_TOKEN=
MAIL_FROM_ADDRESS=

# --- Remediation text (optional; reports fall back to templates without it) -----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
ANTHROPIC_WORKSPACE_ID=

# --- Error tracking (recommended) -----------------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=

# --- Anonymous free-scan throttle (optional; these are the defaults) -------------
# Fixed one-hour windows per client address and per submitter email on POST /v1/scans.
# 0 turns a limit off. The address is the last X-Forwarded-For entry, so keep the API
# behind a proxy that appends the real client address (Caddy does).
SCAN_RATE_PER_IP_PER_HOUR=30
SCAN_RATE_PER_EMAIL_PER_HOUR=10
